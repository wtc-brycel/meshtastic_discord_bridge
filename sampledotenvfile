DISCORD_TOKEN=""
DISCORD_CHANNEL_ID=""
# Use TCP when set; otherwise serial is used.
MESHTASTIC_HOSTNAME=""
MESHTASTIC_SERIAL_PORT="/dev/ttyUSB0"

# Audit JSONL. Use - for stdout (for example, when journald collects stdout).
AUDIT_LOG_PATH="bridge-audit.jsonl"

# Optional line-oriented multimon-ng input. Choose one:
# MULTIMON_SOURCE="stdin"
# MULTIMON_SOURCE="file:/var/lib/meshtastic/multimon.log"
# MULTIMON_SOURCE="command:multimon-ng -a POCSAG512 -t raw -"
# MULTIMON_COMMAND="multimon-ng -a POCSAG512 -t raw -"
# MULTIMON_FILE="/var/lib/meshtastic/multimon.log"

# Optional Star FVP10 output. Disabled by default. The transport receives each
# inbound mesh text message on stdin; this default uses the attached FVP10 CUPS queue.
# FVP10_ENABLED="false"
# FVP10_TRANSPORT_COMMAND="lp -d star -o raw"
# FVP10_TIMEOUT_SECONDS="15"
